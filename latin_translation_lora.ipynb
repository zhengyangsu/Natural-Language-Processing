      "source": [
        "from transformers import pipeline\n",
        "\n",
        "pipe = pipeline(\"text-generation\", model=model, tokenizer=tokenizer)\n",
        "\n",
        "def translate(la, beams=1, max_new_tokens=120):\n",
        "    out = pipe(f\"Latin: {la}\\nEnglish:\",\n",
        "               max_new_tokens=max_new_tokens,\n",
        "               do_sample=False,\n",
        "               num_beams=beams,                  # 1 = greedy，4 = beam search\n",
        "               repetition_penalty=1.1 if beams > 1 else 1.0,\n",
        "               pad_token_id=tokenizer.eos_token_id,   # avoid \"Setting pad_token_id\" warning\n",
        "               return_full_text=False)\n",
        "    return out[0]['generated_text'].split('\\n')[0].strip()\n",
        "\n",
        "q = \"Quo usque tandem abutere, Catilina, patientia nostra?\"\n",
        "print('greedy:', translate(q))\n",
        "print('beam=4:', translate(q, beams=4))\n",
        "\n",
        "model.save_pretrained('latin_lora')  # save LoRA adapter"
      ],
      "id": "oa_a1aREB9kp"

    {
      "cell_type": "markdown",
      "source": [
        "## Add EOS and Cap MAX_LEN"
      ],
      "metadata": {
        "id": "ptIU9TyUFtX2"
      },
      "id": "ptIU9TyUFtX2"
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import AutoTokenizer\n",
        "\n",
        "checkpoint = 'hathibelagal/llama-3.2-latin'  #base model\n",
        "tokenizer = AutoTokenizer.from_pretrained(checkpoint, clean_up_tokenization_spaces=False)\n",
        "tokenizer.pad_token = tokenizer.eos_token\n",
        "\n",
        "MAX_LEN = 256\n",
        "EOS = tokenizer.eos_token\n",
        "\n",
        "def build_text(la, en):\n",
        "    return f\"Latin: {la}\\nEnglish: {en}{EOS}\"           # add EOS\n",
        "\n",
        "# remove beyond MAX_LEN\n",
        "def fits(batch):\n",
        "    texts = [build_text(la, en) for la, en in zip(batch['la'], batch['en'])]\n",
        "    return [len(ids) <= MAX_LEN for ids in tokenizer(texts)['input_ids']]\n",
        "\n",
        "for k in ['train', 'valid', 'test']:\n",
        "    before = len(raw[k])\n",
        "    raw[k] = raw[k].filter(fits, batched=True, batch_size=1000)\n",
        "    after = len(raw[k])\n",
        "    n_dropped = before - after\n",
        "    print(f\"{k}: {before} -> {after} | dropped {n_dropped} ({n_dropped / before * 100:.2f}%)\")"
      ],

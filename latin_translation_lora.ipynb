      "source": [
        "# Metric scorers: BLEU/chrF and ROUGE\n",
        "!pip install -q sacrebleu evaluate rouge_score\n",
        "import json, numpy as np, torch, evaluate\n",
        "from tqdm.auto import tqdm   # progress bar\n",
        "\n",
        "# Load the translation metrics\n",
        "bleu  = evaluate.load('sacrebleu')   # word n-gram overlap with the reference\n",
        "chrf  = evaluate.load('chrf')        # character n-gram overlap\n",
        "rouge = evaluate.load('rouge')       # recall-oriented overlap (ROUGE-1/2/L)\n",
        "\n",
        "def translate_batch(latin_list, max_new_tokens=120):\n",
        "    \"\"\"Translate a list of Latin sentences in one batch and return the English outputs.\"\"\"\n",
        "    tokenizer.padding_side = 'left'   # pad on the left\n",
        "    try:\n",
        "        prompts = [f\"Latin: {la}\\nEnglish:\" for la in latin_list]\n",
        "\n",
        "        # Convert text to token ids; pad to equal length and cap the prompt at MAX_LEN tokens\n",
        "        inputs = tokenizer(prompts, return_tensors='pt', padding=True,\n",
        "                           truncation=True, max_length=MAX_LEN).to(model.device)\n",
        "\n",
        "        with torch.no_grad():   # no gradients needed for inference, saves memory\n",
        "            out = model.generate(**inputs, max_new_tokens=max_new_tokens,\n",
        "                                 do_sample=False,                       # greedy decoding, same output every run\n",
        "                                 pad_token_id=tokenizer.eos_token_id)   # avoid the pad_token_id warning\n",
        "\n",
        "        # Drop the prompt tokens and decode only the newly generated part\n",
        "        texts = tokenizer.batch_decode(out[:, inputs['input_ids'].shape[1]:], skip_special_tokens=True)\n",
        "\n",
        "        # Keep only the first line, in case the model keeps writing after the translation\n",
        "        return [t.split('\\n')[0].strip() for t in texts]\n",
        "    finally:\n",
        "        tokenizer.padding_side = 'right'   # restore right padding for training, even if generation failed\n",
        "\n",
        "def full_eval(label, batch_size=8):\n",
        "    \"\"\"Report loss, perplexity, BLEU, chrF and ROUGE, and save predictions. `label` names the output files.\"\"\"\n",
        "    model.eval()   # switch off dropout and other training-only behavior\n",
        "    print(f'===== {label} =====')\n",
        "\n",
        "    # 1. Loss and perplexity on the tokenized test set, custom test set is not tokenized\n",
        "    result = trainer.evaluate(tokenized['test'])\n",
        "    print(f\"test loss {result['eval_loss']:.4f} | perplexity {np.exp(result['eval_loss']):.2f}\")\n",
        "\n",
        "    # 2. Translate each test set, then score the translations against the references\n",
        "    for name, split in [('test', dataset['test']), ('mine', mine)]:\n",
        "        preds = []\n",
        "        for i in tqdm(range(0, len(split), batch_size), desc=name):\n",
        "            preds += translate_batch(split['la'][i:i + batch_size])   # translate one batch at a time\n",
        "\n",
        "        refs_nested = [[r] for r in split['en']]   # sacrebleu / chrF expect a list of reference lists\n",
        "        refs_flat   = list(split['en'])            # ROUGE takes one reference string per prediction\n",
        "\n",
        "        b = bleu.compute(predictions=preds, references=refs_nested)['score']\n",
        "        c = chrf.compute(predictions=preds, references=refs_nested)['score']\n",
        "        r = rouge.compute(predictions=preds, references=refs_flat)   # returns 0-1 scores\n",
        "\n",
        "        # Multiply ROUGE by 100 so it is on the same 0-100 scale as BLEU and chrF\n",
        "        print(f\"{name:5s} | BLEU {b:.2f} | chrF {c:.2f} | \"\n",
        "              f\"ROUGE-1 {r['rouge1']*100:.2f} | ROUGE-2 {r['rouge2']*100:.2f} | ROUGE-L {r['rougeL']*100:.2f}\")\n",
        "\n",
        "        # Save Latin/reference/prediction for error analysis\n",
        "        with open(f'preds_{label}_{name}.jsonl', 'w', encoding='utf-8') as f:\n",
        "            for la, ref, pred in zip(split['la'], split['en'], preds):\n",
        "                f.write(json.dumps({'la': la, 'ref': ref, 'pred': pred}, ensure_ascii=False) + '\\n')"
      ],
      "id": "47wvwGydB9ko"

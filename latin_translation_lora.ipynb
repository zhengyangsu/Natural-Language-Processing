    {
      "cell_type": "markdown",
      "source": [
        "## Check for Overlapping"
      ],
      "metadata": {
        "id": "n7fzrQd7ex-H"
      },
      "id": "n7fzrQd7ex-H"
    },
    {
      "cell_type": "code",
      "source": [
        "# --- split sizes as percentages ---\n",
        "TRAIN_PCT = 10     # % of train set\n",
        "VAL_PCT   = 20     # % of N_TRAIN\n",
        "TEST_PCT  = 10     # % of N_TRAIN\n",
        "SEED      = 42\n",
        "\n",
        "N_TRAIN = round(len(raw['train']) * TRAIN_PCT / 100)\n",
        "N_VAL   = round(N_TRAIN * VAL_PCT / 100)\n",
        "N_TEST  = round(N_TRAIN * TEST_PCT / 100)\n",
        "print(f\"requested: train {N_TRAIN} ({TRAIN_PCT}% of {len(raw['train'])}) | val {N_VAL} | test {N_TEST}\")\n",
        "\n",
        "\n",
        "# Only used for comparing sentences, never changes the data\n",
        "def key(s):\n",
        "    return s.lower()\n",
        "\n",
        "# 1. Check split overlapping\n",
        "full_train_la = {key(x) for x in raw['train']['la']}\n",
        "print('test/train overlap:', sum(key(x) in full_train_la for x in raw['test']['la']), '/', len(raw['test']))\n",
        "print('valid/train overlap:', sum(key(x) in full_train_la for x in raw['valid']['la']), '/', len(raw['valid']))\n",
        "\n",
        "# val/test set size\n",
        "val = raw['valid'].select(range(N_VAL))\n",
        "val_la = {key(x) for x in val['la']}\n",
        "# take test rows in val\n",
        "test = raw['test'].filter(lambda x: key(x['la']) not in val_la).select(range(N_TEST))\n",
        "\n",
        "# remove val/test sentences from train\n",
        "held_la = {key(x) for x in val['la']} | {key(x) for x in test['la']}\n",
        "held_en = {key(x) for x in val['en']} | {key(x) for x in test['en']}\n",
        "\n",
        "pool = raw['train'].filter(\n",
        "    lambda x: key(x['la']) not in held_la and key(x['en']) not in held_en\n",
        ")\n",
        "print('train pool:', len(raw['train']), '->', len(pool))\n",
        "\n",
        "# remove duplicate Latin sentences inside train\n",
        "seen = set()\n",
        "def first_time(x):\n",
        "    k = key(x['la'])\n",
        "    if k in seen:\n",
        "        return False\n",
        "    seen.add(k)\n",
        "    return True\n",
        "pool = pool.filter(first_time)\n",
        "print('unique:', len(pool))\n",
        "\n",
        "dataset = {\n",
        "    'train': pool.shuffle(seed=SEED).select(range(N_TRAIN)),\n",
        "    'val':   val,\n",
        "    'test':  test,\n",
        "}\n",
        "\n",
        "# verification\n",
        "train_la = {key(x) for x in dataset['train']['la']}\n",
        "print('train ∩ test:', sum(key(x) in train_la for x in dataset['test']['la']))\n",
        "print('train ∩ val :', sum(key(x) in train_la for x in dataset['val']['la']))\n",
        "print('val ∩ test  :', len({key(x) for x in dataset['val']['la']} & {key(x) for x in dataset['test']['la']}))"
      ],
      "metadata": {

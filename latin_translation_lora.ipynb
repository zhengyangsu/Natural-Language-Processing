      "source": [
        "def tokenization(batch):\n",
        "    texts   = [build_text(la, en) for la, en in zip(batch['la'], batch['en'])]\n",
        "    prompts = [f\"Latin: {la}\\nEnglish:\" for la in batch['la']]                  # new: the part to ignore in the loss\n",
        "    enc = tokenizer(texts, truncation=True, max_length=MAX_LEN)\n",
        "    enc['prompt_len'] = [len(ids) for ids in tokenizer(prompts)['input_ids']]    # new: how many tokens the prompt takes\n",
        "    return enc\n",
        "\n",
        "tokenized = {k: v.map(tokenization, batched=True, remove_columns=v.column_names)\n",
        "             for k, v in dataset.items()}\n",
        "\n",
        "assert all(ids[-1] == tokenizer.eos_token_id for ids in tokenized['train']['input_ids'][:100]), 'EOS is missing'\n"
      ],
      "id": "dZYG-rdfB9km"
    },

          "output_type": "stream",
          "name": "stdout",
          "text": [
            "<|begin_of_text|>Latin: Spatium velut aequoris electum quo Mosae fluminis os amnem Rhenum Oceano adfundit.\n",
            "English: The place chosen for the display was a small sea, so to speak, formed at the point where the mouth of the Maas discharges the water of the Rhine into the ocean.<|end_of_text|>\n",
            "trained on:  The place chosen for the display was a small sea, so to speak, formed at the point where the mouth of the Maas discharges the water of the Rhine into the ocean.<|end_of_text|>\n"
          ]
        }
      ],
      "source": [
        "from transformers import Trainer, TrainingArguments, DataCollatorForLanguageModeling  # training tools\n",
        "\n",
        "N_EPOCH = 10 # Training epochs\n",
        "\n",
        "class CausalLMCollator:\n",
        "    def __init__(self, tokenizer):\n",
        "        self.tokenizer = tokenizer\n",
        "\n",
        "    def __call__(self, features):\n",
        "        self.tokenizer.padding_side = 'right'\n",
        "        prompt_lens = [f.pop('prompt_len') for f in features]      # new: take it out before padding\n",
        "        batch = self.tokenizer.pad(features, return_tensors='pt')\n",
        "        labels = batch['input_ids'].clone()\n",
        "        labels[batch['attention_mask'] == 0] = -100                 # ignore padding\n",
        "        for i, n in enumerate(prompt_lens):                         # new: ignore the Latin prompt\n",
        "            labels[i, :n] = -100\n",
        "        batch['labels'] = labels\n",
        "        return batch\n",
        "'''\n",
        "model = get_peft_model(model, LoraConfig(\n",
        "    r=32,\n",
        "    lora_alpha=64,                           # 2 x r\n",
        "    lora_dropout=0.05,                       # new\n",
        "    bias='none',\n",
        "    target_modules=['q_proj', 'k_proj', 'v_proj', 'o_proj',\n",
        "                    'gate_proj', 'up_proj', 'down_proj'],   # new: all linear layers\n",
        "    task_type='CAUSAL_LM'))\n",
        "'''\n",
        "\n",
        "training_args = TrainingArguments(\n",
        "    seed=SEED,\n",
        "    output_dir='./results',\n",
        "    num_train_epochs=N_EPOCH,  # total passes\n",
        "    per_device_train_batch_size=4,  # 4 examples/step (small to fit GPU memory)\n",
        "    gradient_accumulation_steps=4,  # accumulate 4 steps before each update\n",
        "    learning_rate=2e-4,  # step size\n",
        "    fp16=True,  # 16-bit training (T4 supports fp16 not bf16)\n",
        "    eval_strategy='epoch',  # evaluate on the validation set at the end of each epoch\n",
        "    save_strategy='epoch',\n",
        "    load_best_model_at_end=True,   # load best chkpt\n",
        "    greater_is_better=False,\n",
        "    logging_strategy=\"steps\",\n",
        "    logging_steps=10,\n",
        "    remove_unused_columns=False,   # keep prompt_len for collator\n",
        "    report_to='none',\n",
        ")\n",
        "\n",
        "trainer = Trainer(\n",
        "    model=model,  # LoRA model\n",
        "    args=training_args,\n",
        "    train_dataset=tokenized['train'],\n",
        "    eval_dataset=tokenized['val'],\n",
        "    data_collator=CausalLMCollator(tokenizer)\n",
        ")\n",
        "\n",
        "batch = CausalLMCollator(tokenizer)([dict(tokenized['train'][0])])\n",
        "print(tokenizer.decode(batch['input_ids'][0]))\n",
        "print('trained on:', tokenizer.decode([t for t in batch['labels'][0] if t != -100]))"
      ],
      "id": "8wScUXKlB9ko"
    },

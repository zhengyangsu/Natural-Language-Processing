    {
      "cell_type": "markdown",
      "source": [
        "## Data Cleanup"
      ],
      "metadata": {
        "id": "5S19GPETb-hb"
      },
      "id": "5S19GPETb-hb"
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install langid --quiet # langid to check latin in en key\n",
        "\n",
        "import re, unicodedata\n",
        "from langid.langid import LanguageIdentifier, model\n",
        "from collections import Counter\n",
        "\n",
        "ident = LanguageIdentifier.from_modelstring(model, norm_probs=True)\n",
        "drop_counts = Counter()   # check counter\n",
        "\n",
        "\n",
        "# Unicode normalize, remove html tags, collapse space\n",
        "def clean_text(s):\n",
        "    s = unicodedata.normalize('NFC', s)       # unify Unicode forms\n",
        "    s = re.sub(r'</?[a-zA-Z][^>]*>', ' ', s)  # remove HTML tags\n",
        "    return ' '.join(s.split())                # collapse whitespace\n",
        "\n",
        "# True if en column is 0.9 confident detected as Latin\n",
        "def en_is_latin(x):\n",
        "    if len(x['en'].split()) < 6:          # skip short text\n",
        "        return False\n",
        "    lang, prob = ident.classify(x['en'])\n",
        "    return lang == 'la' and prob > 0.9\n",
        "\n",
        "# Keep pair only if it passes all checks\n",
        "def is_ok(x):\n",
        "    n_la, n_en = len(x['la'].split()), len(x['en'].split())\n",
        "    if n_la < 3 or n_en < 3:              # sentence too short\n",
        "        drop_counts['short_sentence'] += 1\n",
        "        return False\n",
        "    if en_is_latin(x):                    # en column is latin\n",
        "        drop_counts['en_is_latin'] += 1\n",
        "        return False\n",
        "    if not (0.3 <= n_en / n_la <= 4):     # lengths misalignment\n",
        "        drop_counts['length_misalignment'] += 1\n",
        "        return False\n",
        "    return True\n",
        "\n",
        "# Text cleaning\n",
        "raw = raw.map(lambda x: {'la': clean_text(x['la']), 'en': clean_text(x['en'])})\n",
        "\n",
        "# Filter splits\n",
        "for k in ['train', 'valid', 'test']:\n",
        "    drop_counts.clear() # reset split filter count\n",
        "    before = len(raw[k])\n",
        "    raw[k] = raw[k].filter(is_ok, load_from_cache_file=False)   # force counters update\n",
        "    print(f\"\\n[{k}] {before} -> {len(raw[k])}\")\n",
        "    for reason in ['short_sentence', 'en_is_latin', 'length_misalignment']:\n",
        "        print(f\"  {reason:20s}: {drop_counts[reason]}\")\n",
        "    print(f\"  {'total dropped':20s}: {sum(drop_counts.values())}\")"
      ],
